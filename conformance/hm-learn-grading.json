{
  "format": "hm-conformance",
  "version": 1,
  "subject": "hm-learn-grading",
  "description": "Grading an answer with learn-sdk's default language profile, which applies Unicode NFC and nothing else: no case folding, trimming or locale rules, and no ICU. input.exercise is one exercise, read as an hm-learn-content document of its own, and input.answer the learner's answer. expected is the grade, or the rejection.",
  "cases": [
    {
      "name": "multiple choice: both right",
      "input": {
        "exercise": {
          "id": "mc",
          "type": "multiple-choice",
          "payload": {
            "questions": [
              {
                "prompt": "กิน",
                "choices": [
                  "eat",
                  "drink"
                ],
                "correct": 0
              },
              {
                "prompt": "ดื่ม",
                "choices": [
                  "eat",
                  "drink",
                  "sleep"
                ],
                "correct": 1
              }
            ]
          }
        },
        "answer": {
          "selected": [
            0,
            1
          ]
        }
      },
      "expected": {
        "score": 2,
        "max": 2,
        "items": [
          true,
          true
        ]
      }
    },
