{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ie-huss-martinez/learn-sdk/blob/main/formats/hm-learn-progress/v1.schema.json",
  "title": "hm-learn-progress, version 1",
  "description": "One scope's learning progress (docs/formats/hm-learn-progress.md, learn-sdk ADR 0006, sdk-core ADR 0045): the learner's attempts, and each item's scheduling card. An attempt's answer and a card's scheduler state are opaque: any JSON value, copied unchanged. Beyond this schema, readers check that a grade's score is at most its max. The whole document is at most 2,000,000 UTF-8 bytes by default, which a schema can't express.",
  "type": "object",
  "required": ["format", "version", "attempts", "cards"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "hm-learn-progress"
    },
    "version": {
      "const": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "text": {
      "description": "A text of 1 to 2,000 Unicode code points (the default maxTextLength) with at least one character that isn't white space, as ECMAScript's String.prototype.trim defines it.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "whole": {
      "description": "A whole number, at most 2^53 - 1.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time": {
      "description": "A time in milliseconds since the Unix epoch, after it.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt": {
      "description": "One graded attempt at an exercise.",
      "type": "object",
      "required": ["exerciseId", "answer", "grade", "at"],
      "additionalProperties": false,
      "properties": {
        "exerciseId": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "description": "The learner's answer, in its exercise type's shape. Opaque: any JSON value, copied unchanged.",
          "$comment": "Deliberately unconstrained."
        },
        "grade": {
          "type": "object",
          "required": ["score", "max", "items"],
          "additionalProperties": false,
          "properties": {
            "score": {
              "$ref": "#/$defs/whole"
            },
            "max": {
              "$ref": "#/$defs/whole"
            },
            "items": {
              "description": "Whether each item was right.",
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "boolean"
              }
            }
          }
        },
        "at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "card": {
      "description": "An item's review card: the latest scheduling state, and when it's next due.",
      "type": "object",
      "required": ["itemId", "scheduling", "due"],
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "$ref": "#/$defs/text"
        },
        "scheduling": {
          "description": "The scheduler's state, in its envelope.",
          "type": "object",
          "required": ["scheduler", "model", "version", "card"],
          "additionalProperties": false,
          "properties": {
            "scheduler": {
              "$ref": "#/$defs/text"
            },
            "model": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "$ref": "#/$defs/whole"
            },
            "card": {
              "description": "The scheduler's own state. Opaque: any JSON value, copied unchanged, versioned by scheduler, model and version.",
              "$comment": "Deliberately unconstrained."
            }
          }
        },
        "due": {
          "$ref": "#/$defs/time"
        }
      }
    }
  }
}
