{
  "name": "@hussmartinez/learn-sdk-example-vite",
  "private": true,
  "description": "A Vite page that runs the built @hussmartinez/learn-sdk player under a strict Content Security Policy, for the end-to-end tests and the screen-reader pass.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --port 4340 --strictPort"
  },
  "dependencies": {
    "@hussmartinez/learn-sdk": "workspace:*",
    "@hussmartinez/ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@hussmartinez/sdk-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
